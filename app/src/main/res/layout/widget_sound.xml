<?xml version="1.0" encoding="utf-8"?>
<!--
  1×1 widget layout.
  ImageView fills the entire cell. The bitmap is pre-rendered with a
  rounded-rect mask in SoundWidgetProvider so no clip is needed here.
  Label sits below, overlapping the bottom edge.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="4dp">

    <!-- Icon fills the whole cell -->
    <ImageView
        android:id="@+id/widget_icon_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/widget_icon_label"
        android:scaleType="fitXY"
        android:adjustViewBounds="false"
        android:contentDescription="@null" />

    <!-- Name label pinned to bottom -->
    <TextView
        android:id="@+id/widget_icon_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="10sp"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:paddingBottom="2dp" />

</RelativeLayout>
